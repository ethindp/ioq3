if(NOT BUILD_CLIENT)
    return()
endif()

set(INTERNAL_PRISM_DIR ${SOURCE_DIR}/thirdparty/prism-0.16.7)
if(USE_INTERNAL_PRISM)
    set(PRISM_ENABLE_GDEXTENSION OFF)
    set(PRISM_ENABLE_TESTS       OFF)
    set(PRISM_ENABLE_DEMOS       OFF)
    set(PRISM_ENABLE_LINTING     OFF)
    set(PRISM_ENABLE_LEGACY_BACKENDS ON)
    set(PRISM_ENABLE_LEGACY_SYSTEM_ACCESS_BACKEND ON)
    set(PRISM_ENABLE_LEGACY_WINDOW_EYES_BACKEND ON)
    add_subdirectory(${INTERNAL_PRISM_DIR} ${CMAKE_BINARY_DIR}/thirdparty/prism EXCLUDE_FROM_ALL)
else()
    find_package(prism CONFIG REQUIRED)
endif()
list(APPEND CLIENT_LIBRARIES prism::prism)
list(APPEND CLIENT_DEFINITIONS USE_PRISM)